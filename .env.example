# Copy to .env and fill in. Nothing here is required to run the test suite.

# The database the application reads (CLI, migrations, verification UI).
# Not used by the tests.
PLAIN_SIGHT_DATABASE_URL=

# Where the `-m postgres` tests run. Optional: when unset they use exactly this
# URL, the `db` service in compose.yaml (`docker compose up -d db`).
#
# The fixture drops and re-migrates every table, so it refuses any host that is
# not loopback and any database not named `*_test`. There is no override. Never
# point this at a hosted database.
PLAIN_SIGHT_TEST_DATABASE_URL=postgresql://plain_sight:plain_sight@localhost:15432/plain_sight_test

# Extraction model id, used only with the optional `llm` extra installed.
PLAIN_SIGHT_MODEL_ID=claude-opus-4-8

# Where immutable source PDFs are written (content-addressed).
PLAIN_SIGHT_DATA_DIR=data/documents
